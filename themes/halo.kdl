// halo — a compact icon-only pill at screen centre, with little dimming.
extends "dusk"
layout "row"

tokens {
    compact #true
    header #false
    orb-size 0
    bloom-a "#5b4bff/14"
    bloom-b "#ff6a4d/10"
    dim "#000000/18"
    backdrop-top "#171129/20"
    backdrop-bottom "#341822/18"
    card "#0b0a12/90"
    card-border "#ffffff/20"
    shadow "#000000/30"
    radius 34
    card-width 62
    card-height 62
    gap 8
    icon-size 26
    padding 8
    label-size 12
    key-size 10
    enter-ms 220
    exit-ms 110
    stagger-ms 22
}

tokens "light" {
    dim "#ffffff/24"
    backdrop-top "#e9e3f7/24"
    backdrop-bottom "#f7e6e0/20"
    card "#ffffff/82"
    card-border "#000000/14"
    shadow "#000000/12"
}
